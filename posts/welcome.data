[{"_1":2},"routes/posts.$slug",{"_3":4},"data",{"_5":6,"_7":-5,"_8":9},"post",{"_10":14,"_12":15,"_16":17,"_18":19,"_20":21,"_22":23,"_24":25,"_26":27,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37},"prevPost","nextPost",{"_10":11,"_12":13},"title","测试-记录的第一篇文章","slug","记录第一篇文章","关于这个站点","welcome","date","2026-10-06T16:00:00.000Z","draft",false,"metadata",{"_45":46,"_47":48},"excerpt","这个站点用来记录一些思考、随手记和长文。\n\n「说说」是短动态，想到什么发什么。\n「文章」是写完整的内容。\n\n怎么用\n# 上传图片，markdown 链接自动进剪贴板\n./upload.sh ~/Desktop/截图.png\n\n# 编辑 content/memos/001.md 写微博（新内容写在文件最前面）\n# 编辑 content/posts/*.md 写文章\n\n# 构建并上线\n./deploy.sh\n\n代码块右上角有复制按钮，点一下就能拿走代码。","content_html","<p>这个站点用来记录一些思考、随手记和长文。</p>\n<ul>\n<li>「说说」是短动态，想到什么发什么。</li>\n<li>「文章」是写完整的内容。</li>\n</ul>\n<h2>怎么用</h2>\n<pre><code class=\"language-bash\"># 上传图片，markdown 链接自动进剪贴板\n./upload.sh ~/Desktop/截图.png\n\n# 编辑 content/memos/001.md 写微博（新内容写在文件最前面）\n# 编辑 content/posts/*.md 写文章\n\n# 构建并上线\n./deploy.sh\n</code></pre>\n<p>代码块右上角有复制按钮，点一下就能拿走代码。</p>","content_jsx","const{Fragment:n,jsx:e,jsxs:c}=arguments[0];function _createMdxContent(s){const l={code:\"code\",h2:\"h2\",li:\"li\",p:\"p\",pre:\"pre\",span:\"span\",ul:\"ul\",...s.components};return c(n,{children:[e(l.p,{children:\"这个站点用来记录一些思考、随手记和长文。\"}),\"\\n\",c(l.ul,{children:[\"\\n\",e(l.li,{children:\"「说说」是短动态，想到什么发什么。\"}),\"\\n\",e(l.li,{children:\"「文章」是写完整的内容。\"}),\"\\n\"]}),\"\\n\",e(l.h2,{id:\"怎么用\",children:\"怎么用\"}),\"\\n\",e(l.pre,{children:c(l.code,{className:\"hljs language-bash\",children:[e(l.span,{className:\"hljs-comment\",children:\"# 上传图片，markdown 链接自动进剪贴板\"}),\"\\n./upload.sh ~/Desktop/截图.png\\n\\n\",e(l.span,{className:\"hljs-comment\",children:\"# 编辑 content/memos/001.md 写微博（新内容写在文件最前面）\"}),\"\\n\",e(l.span,{className:\"hljs-comment\",children:\"# 编辑 content/posts/*.md 写文章\"}),\"\\n\\n\",e(l.span,{className:\"hljs-comment\",children:\"# 构建并上线\"}),\"\\n./deploy.sh\\n\"]})}),\"\\n\",e(l.p,{children:\"代码块右上角有复制按钮，点一下就能拿走代码。\"})]})}return{default:function(n={}){const{wrapper:c}=n.components||{};return c?e(c,{...n,children:e(_createMdxContent,{...n})}):_createMdxContent(n)}};","toc",[39],"tags",[38],"categories","其他","keywords",[],"permalink","/posts/welcome","blog",{"_10":40,"_41":42,"_43":44},"怎么用","url","#怎么用","items",[],"readingTime",1,"wordCount",70.12]
