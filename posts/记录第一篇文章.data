[{"_1":2},"routes/posts.$slug",{"_3":4},"data",{"_5":6,"_7":8,"_9":10},"post",{"_11":17,"_13":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40},"prevPost",{"_11":15,"_13":16},"nextPost",{"_11":12,"_13":14},"title","Markdown 测试","slug","markdowntest","关于这个站点","welcome","测试-记录的第一篇文章","记录第一篇文章","date","2026-10-06T16:00:00.000Z","draft",false,"metadata",{"_52":53,"_54":55},"excerpt","记录的第一篇教程文章\n这个仅仅是测试，没有任何实际意义。\n代码段\n\n怎么上传图片\n# 上传图片，markdown 链接自动进剪贴板\n./upload.sh ~/Desktop/截图.png\n\n# 编辑 content/memos/001.md 写微博（新内容写在文件最前面）\n# 编辑 content/posts/*.md 写文章\n\n# 构建并上线\n./deploy.sh\n\n代码块右上角有复制按钮，点一下就能拿走代码。","content_html","<h2>记录的第一篇教程文章</h2>\n<p>这个仅仅是测试，没有任何实际意义。</p>\n<pre><code>代码段\n</code></pre>\n<h2>怎么上传图片</h2>\n<pre><code class=\"language-bash\"># 上传图片，markdown 链接自动进剪贴板\n./upload.sh ~/Desktop/截图.png\n\n# 编辑 content/memos/001.md 写微博（新内容写在文件最前面）\n# 编辑 content/posts/*.md 写文章\n\n# 构建并上线\n./deploy.sh\n</code></pre>\n<p>代码块右上角有复制按钮，点一下就能拿走代码。</p>","content_jsx","const{Fragment:n,jsx:e,jsxs:c}=arguments[0];function _createMdxContent(s){const r={code:\"code\",h2:\"h2\",p:\"p\",pre:\"pre\",span:\"span\",...s.components};return c(n,{children:[e(r.h2,{id:\"记录的第一篇教程文章\",children:\"记录的第一篇教程文章\"}),\"\\n\",e(r.p,{children:\"这个仅仅是测试，没有任何实际意义。\"}),\"\\n\",e(r.pre,{children:e(r.code,{children:\"代码段\\n\"})}),\"\\n\",e(r.h2,{id:\"怎么上传图片\",children:\"怎么上传图片\"}),\"\\n\",e(r.pre,{children:c(r.code,{className:\"hljs language-bash\",children:[e(r.span,{className:\"hljs-comment\",children:\"# 上传图片，markdown 链接自动进剪贴板\"}),\"\\n./upload.sh ~/Desktop/截图.png\\n\\n\",e(r.span,{className:\"hljs-comment\",children:\"# 编辑 content/memos/001.md 写微博（新内容写在文件最前面）\"}),\"\\n\",e(r.span,{className:\"hljs-comment\",children:\"# 编辑 content/posts/*.md 写文章\"}),\"\\n\\n\",e(r.span,{className:\"hljs-comment\",children:\"# 构建并上线\"}),\"\\n./deploy.sh\\n\"]})}),\"\\n\",e(r.p,{children:\"代码块右上角有复制按钮，点一下就能拿走代码。\"})]})}return{default:function(n={}){const{wrapper:c}=n.co